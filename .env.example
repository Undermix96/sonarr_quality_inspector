# ── Required ────────────────────────────────────────────────────────────────

# Full URL of your Sonarr instance.
# Supports: http://ip:port, https://domain, http://docker-hostname:port
SONARR_URL=http://sonarr:8989

# API key from Sonarr → Settings → General → Security → API Key
SONARR_API_KEY=your_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Only set if you access the app from a different domain.
# Leave empty for same-origin only (safest default).
ALLOWED_ORIGINS=

# Internal container port (default: 3000)
PORT=3000

# Host port to bind (default: 3000)
EXTERNAL_PORT=3000
